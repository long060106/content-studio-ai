# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# Optional: only needed if you see "Sign in to confirm you're not a bot"
# errors from yt-dlp. Set this to your browser's name (chrome, firefox,
# edge, or brave) so yt-dlp can reuse that browser's YouTube login cookies.
# Close the browser fully before running if you hit a "file in use" error.
# YouTube blocks unauthenticated downloads with HTTP 403. Either works;
# the cookies file is more reliable on Windows because Chrome and Edge
# lock their cookie database while running.
# YTDLP_COOKIES_FILE=C:/path/to/cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Optional: only needed for voice-over generation. Get a free-tier key from
# https://elevenlabs.io/app/settings/api-keys — if this isn't set, the
# pipeline just skips the voice-over step and generates everything else.
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# Optional overrides (defaults are set in text_to_speech.py):
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Optional but strongly recommended: stock footage and stills for the
# motivational shorts, posters and carousels. Both are free.
#
# This is the single biggest lever on image quality. Without a key the
# pipeline falls back to Openverse and Wikimedia, which need no key but are an
# encyclopedia media repo and a CC aggregator — they have far less of the
# photography this kind of content wants. Video b-roll needs a key outright.
# PEXELS_API_KEY=your_key_here      # https://www.pexels.com/api/
# PIXABAY_API_KEY=your_key_here     # https://pixabay.com/api/docs/
